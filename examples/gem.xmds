<?xml version="1.0" encoding="UTF-8"?>
<simulation xmds-version="2">
  <name>gem</name>
  <author>causalwave contributors</author>
  <description>&#20004;&#33021;&#32423;GEM&#31034;&#20363;&#65307;&#38454;&#27573;&#36793;&#30028;&#19982;&#26799;&#24230;&#32763;&#36716;&#26102;&#21051;&#20005;&#26684;&#23545;&#40784;&#65292;&#36755;&#20986;&#23436;&#25972;&#22797;&#22330;&#12290;</description>
  <features>
    <validation kind="run-time"/>
    <globals><![CDATA[
      const real coupling = 1;
      const real density = 2;
      const real length = 1;
      const real gradient = 4;
      const real gamma_signed = 0.0;
      const real pulse_time = 0.3;
      const real pulse_width = 0.1;
      const real amplitude = 1.0;
    ]]></globals>
  </features>
  <geometry>
    <propagation_dimension>t</propagation_dimension>
    <transverse_dimensions>
      <dimension name="z" lattice="128" domain="(0, 1)"/>
    </transverse_dimensions>
  </geometry>
  <vector name="coherence" type="complex" initial_space="z">
    <components>alpha</components>
    <initialisation><![CDATA[alpha = 0;]]></initialisation>
  </vector>
  <vector name="field" type="complex" initial_space="z">
    <components>E</components>
  </vector>
  <sequence>
    <integrate algorithm="ARK89" interval="1.0" steps="1000" tolerance="1e-08">
      <samples>40</samples>
      <operators>
        <operator kind="cross_propagation" algorithm="RK4" propagation_dimension="z">
          <integration_vectors>field</integration_vectors>
          <dependencies>coherence</dependencies>
          <boundary_condition kind="left"><![CDATA[
            E = amplitude * exp(-pow((t - pulse_time) / pulse_width, 2));
          ]]></boundary_condition>
          <![CDATA[dE_dz = i * density * alpha;]]>
        </operator>
        <integration_vectors>coherence</integration_vectors>
        <![CDATA[dalpha_dt = (gamma_signed + i * gradient * (z - length/2)) * alpha + i * coupling * E;]]>
      </operators>
    </integrate>
    <integrate algorithm="ARK89" interval="1.0" steps="1000" tolerance="1e-08">
      <samples>40</samples>
      <operators>
        <operator kind="cross_propagation" algorithm="RK4" propagation_dimension="z">
          <integration_vectors>field</integration_vectors>
          <dependencies>coherence</dependencies>
          <boundary_condition kind="left"><![CDATA[
            E = amplitude * exp(-pow((t - pulse_time) / pulse_width, 2));
          ]]></boundary_condition>
          <![CDATA[dE_dz = i * density * alpha;]]>
        </operator>
        <integration_vectors>coherence</integration_vectors>
        <![CDATA[dalpha_dt = (gamma_signed - i * gradient * (z - length/2)) * alpha + i * coupling * E;]]>
      </operators>
    </integrate>
  </sequence>
  <output format="ascii" filename="gem.xsil">
    <group>
      <sampling basis="z(64)" initial_sample="no">
        <moments>E_real E_imag alpha_real alpha_imag</moments>
        <dependencies>coherence field</dependencies>
        <![CDATA[
          E_real = E.Re(); E_imag = E.Im();
          alpha_real = alpha.Re(); alpha_imag = alpha.Im();
        ]]>
      </sampling>
    </group>
  </output>
</simulation>
